# ========== 阿里百炼 DashScope ==========
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ========== 模型配置 ==========
ANSWER_MODEL=deepseek-v4-flash-0731
EVAL_MODEL=qwen3.7-flash-2026-07-15
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2

# ========== 服务配置 ==========
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# ========== Chroma 向量库 ==========
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma/vector_store

# ========== Redis 缓存 ==========
REDIS_HOST=redis
REDIS_PORT=6379

# ========== 重试配置 ==========
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=1.0
RETRY_MAX_WAIT=4.0

# ========== 限流配置 ==========
DASHSCOPE_MAX_CONCURRENCY=8
API_RATE_LIMIT=30/minute

# ========== 可观测性 LangSmith ==========
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doc-qa-system
LANGSMITH_TRACING=false

# ========== 缓存配置 ==========
CACHE_DB_PATH=./db/cache/rag_cache.db
RETRIEVAL_CACHE_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=7200
